# M'trix — Configuration example
# Copier ce fichier en .env et remplir les valeurs

# --- Application
APP_NAME=M'trix
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8099

# --- Base de données
DB_HOST=localhost
DB_PORT=3306
DB_NAME=mtrix_prod
DB_USER=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# --- Paiement (FedaPay)
FEDAPAY_MODE=api
FEDAPAY_API_KEY=fpk_live_xxxxxxxxxxxxxxxxxxxxx
FEDAPAY_PUBLIC_KEY=fpk_pub_xxxxxxxxxxxxxxxxxxxxx
FEDAPAY_MERCHANT_ID=merchant_xxxxx
FEDAPAY_WEBHOOK_SECRET=webhook_secret_xxxxx

# --- Email (Brevo SMTP)
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=votre_email@example.com
MAIL_PASSWORD=xsmtpxxxxxxxxxxxxxxxxxxx
MAIL_FROM_ADDRESS=noreply@mtrix.com
MAIL_FROM_NAME=M'trix

# --- Admin
ADMIN_PASSWORD_HASH=$2y$12$xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SESSION_SECRET=generate_long_random_string_with_bin2hex_random_bytes_32

# --- Contact
WHATSAPP=22958779933
INSTAGRAM=mtrix229
TIKTOK=mtrix2290

# --- Sécurité
CORS_ORIGINS=https://mtrix.com,http://localhost:3000
JWT_SECRET=generate_long_random_string_here
JWT_EXPIRY=3600

# --- Logs
LOG_LEVEL=info
LOG_PATH=storage/logs
